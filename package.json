{
  "name": "compliance-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker start compliance-radar-db 2>/dev/null || docker run --name compliance-radar-db -e POSTGRES_PASSWORD=radar -e POSTGRES_USER=radar -e POSTGRES_DB=compliance_radar -p 5433:5432 -d postgres:16",
    "db:down": "docker stop compliance-radar-db",
    "db:seed": "tsx prisma/seed.ts",
    "db:recompute": "tsx prisma/recompute.ts",
    "db:backfill": "tsx prisma/backfill.ts",
    "db:requests": "tsx prisma/requests.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts && tsx prisma/recompute.ts && tsx prisma/backfill.ts && tsx prisma/requests.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^6.19.3",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
